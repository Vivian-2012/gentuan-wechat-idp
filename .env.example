# ========== Backend (Cloudflare Worker / wrangler secret) ==========
# Copy to be/.dev.vars for local: wrangler dev

# 微信开放平台 · 网站应用（扫码登录 snsapi_login）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 本 Worker 对外 URL（本地示例 http://127.0.0.1:8787）
PUBLIC_API_URL=http://127.0.0.1:8787

# 登录成功后跳回的前端地址
FRONTEND_URL=http://127.0.0.1:5500

# 逗号分隔：这些 openid / unionid 视为管理员（可管跟团数据）
ADMIN_OPENIDS=

# 本地无微信凭证时：MOCK_WECHAT=1 用假 openid 走通流程
MOCK_WECHAT=1
MOCK_OPENID=mock-admin-openid

# Supabase（与现有小灵群同一项目即可）
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
# 仅后端持有，绝不能进前端仓库明文
SUPABASE_SERVICE_ROLE_KEY=

# 随机长字符串，用于 state / 会话签名
SESSION_SECRET=change-me-to-a-long-random-string
